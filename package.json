{
  "name": "bw-ladder-review-overlay",
  "version": "1.1.0",
  "description": "Reviews and grades your StarCraft: Remastered ladder games as you finish them, and serves the report card as an OBS browser overlay.",
  "type": "module",
  "main": "main/main.cjs",
  "author": "Platinum Esport",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "review": "node src/main.js --once",
    "serve": "node src/main.js",
    "build:native": "native\\build-stats.bat",
    "build:native:bwfind": "native\\build-bwfind.bat",
    "dist": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.platinumesport.bwladderreview",
    "productName": "BW Ladder Review",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bwstats.exe",
        "to": "bwstats.exe"
      },
      {
        "from": "native/bwfind.exe",
        "to": "bwfind.exe"
      },
      {
        "from": "native/groundtruth/unit-costs.csv",
        "to": "groundtruth/unit-costs.csv"
      },
      {
        "from": "native/groundtruth/upgrade-costs.csv",
        "to": "groundtruth/upgrade-costs.csv"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "BW Ladder Review.exe"
    }
  }
}
